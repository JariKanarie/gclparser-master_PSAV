name:                GCLparser
version:             0.2.1
-- synopsis:
-- description:
license:             BSD3
license-file:        LICENSE
author:              Stefan Koppier, Wishnu Prasetya
-- maintainer:          s.koppier@students.uu.nl
-- copyright:
category:            Testing
build-type:          Simple
extra-source-files:  README.md
cabal-version:       >=1.10

Library
  exposed-modules:     GCL.GCLParser.Parser
                     , GCL.GCLParser.GCLDatatype
                     , GCL.GCLParser.PrettyPrint
                     , GCL.GCLInterpreter
                     , GCL.MuGCL
                     , GCL.GCLUtils
                     , GCL.GCLLexer.Token
                     , GCL.GCLLexer.Lexer
                     , GCL.ExamplesOfSemanticFunction

                     , TestZ3_from_website
                     , TestZ3_simple
                     , TestZ3_test1
                     , TestZ3_test2
                     , Z3.Z3ModelChecker
                     , Z3ProverExample

                     , WLP.Wlp
                     , WLPTest 
                     , WLP.Invariant
                     , InvariantTest
                     , WLP.Simplify
                     , WLP.Helper
                     , WLP.ProgramTypes
                     , WLP.PathGen
                     , Main
  -- other-extensions:
  build-depends:       base   >= 4.10
                     , array
                     , containers
                     , optparse-applicative
                     , pretty
                     , directory
                     , z3
                     , process
                     , time
                     , filepath
  hs-source-dirs:      src , examples/GCL/examplesHaskellZ3 , examples/WLP , examples/WLP/WLPTest
  -- location to z3 bin and lib:
  -- extra-lib-dirs:      ~/workshop/tools/z3-4.8.8/bin
  -- extra-include-dirs:  ~/workshop/tools/z3-4.8.8/bin
  build-tools:         happy, alex
  default-language:    Haskell2010
  GHC-Options:         -Wall
  default-extensions:  TupleSections
                     , NamedFieldPuns
                     , ScopedTypeVariables
